library(tidyverse)
library(sjPlot)
library(haven)
Invisibility <- read_sav("https://github.com/jvanster/Psy_300_Datasets/raw/refs/heads/main/SPSS_Datasets/Invisibility.sav")
Invisibility
t.test(Mischief ~ Cloak, data = Invisibility)
t.test(Mischief ~ factor(Cloak, levels = c(1, 0)), data = Invisibility,
alternative = "greater")
(5.00-3.75)/(sqrt(1.91^2/12 + 1.65^2/12))
t.test(Mischief ~ factor(Cloak, levels = c(1, 0)), data = Invisibility)
dist_t(deg.f = 22, p = 1)
t_obs <- 1.7135   # t score from the t.test() output
df <- 22
ggplot(data.frame(x = c(-4, 4)), aes(x)) +
stat_function(fun = dt, args = list(df = df),
geom = "area", xlim = c(-4, -t_obs), fill = "steelblue", alpha = 0.5) +
stat_function(fun = dt, args = list(df = df),
geom = "area", xlim = c(t_obs, 4), fill = "steelblue", alpha = 0.5) +
stat_function(fun = dt, args = list(df = df), linewidth = 1) +
geom_vline(xintercept = c(-t_obs, t_obs), linetype = "dashed") +
annotate("text", x = c(-3, 3), y = 0.08, label = "p/2 = .0504") +
labs(title = "Two-Tailed t Distribution (df = 22)",
subtitle = "Shaded area = p = .1007",
x = "t", y = "Density") +
theme_minimal()
t.test(Mischief ~ factor(Cloak,
levels = c(1, 0)),
var.equal = TRUE,
data = Invisibility)
t.test(Mischief ~ factor(Cloak, levels = c(1, 0)), data = Invisibility, var.equal = TRUE)
df <- 22
t_obs <- 1.7135                 # obtained t score from t.test()
t_crit <- qt(0.975, df)         # two-tailed critical value, alpha = .05 (2.07)
ggplot(data.frame(x = c(-4, 4)), aes(x)) +
stat_function(fun = dt, args = list(df = df),
geom = "area", xlim = c(-4, -t_crit), fill = "firebrick", alpha = 0.5) +
stat_function(fun = dt, args = list(df = df),
geom = "area", xlim = c(t_crit, 4), fill = "firebrick", alpha = 0.5) +
stat_function(fun = dt, args = list(df = df), linewidth = 1) +
geom_vline(xintercept = t_obs, linetype = "dashed", linewidth = 1, color = "steelblue") +
annotate("text", x = t_obs, y = 0.25, label = "Obtained t = 1.71",
hjust = -0.1, color = "steelblue") +
annotate("text", x = c(-3.1, 3.1), y = 0.06,
label = c("Reject null\nt < -2.07", "Reject null\nt > 2.07"), color = "firebrick") +
labs(title = "Rejection Region for a Two-Tailed t Test (df = 22, α = .05)",
x = "t", y = "Density") +
theme_minimal()
t.test(Mischief ~ factor(Cloak, levels = c(1, 0)), data = Invisibility, var.equal = TRUE)
