t_crit <- qt(0.975, df)         # two-tailed critical value, alpha = .05 (2.07)
ggplot(data.frame(x = c(-4, 4)), aes(x)) +
stat_function(fun = dt, args = list(df = df),
geom = "area", xlim = c(-4, -t_crit), fill = "firebrick", alpha = 0.5) +
stat_function(fun = dt, args = list(df = df),
geom = "area", xlim = c(t_crit, 4), fill = "firebrick", alpha = 0.5) +
stat_function(fun = dt, args = list(df = df), linewidth = 1) +
geom_vline(xintercept = t_obs, linetype = "dashed", linewidth = 1, color = "steelblue") +
annotate("text", x = t_obs, y = 0.25, label = "Obtained t = 1.71",
hjust = -0.1, color = "steelblue") +
annotate("text", x = c(-3.1, 3.1), y = 0.06,
label = c("Reject null\nt < -2.07", "Reject null\nt > 2.07"), color = "firebrick") +
labs(title = "Rejection Region for a Two-Tailed t Test (df = 22, α = .05)",
x = "t", y = "Density") +
theme_minimal()
library(tidyverse)
Pain_Data = data.frame(Group = rep(c("Neutral", "Thalamus"), times = c(8,7)),
Flinch = c(.8, .7, 1.2, .5, .4, .9, 1.4, 1.1, 1.9,
1.8, 1.6, 1.2, 1, .9, 1.7))
Pain_Data
Pain_Data$Group
t.test(Flinch ~ factor(Group, levels = c(Thalamus, Neutral)),
data = Pain_Data, var.equal = TRUE)
t.test(Flinch ~ Group,
data = Pain_Data, var.equal = TRUE)
?t.test
t.test(Flinch ~ Group,
data = Pain_Data, var.equal = TRUE, alternative = "greater")
t.test(Flinch ~ Group,
data = Pain_Data, var.equal = TRUE, alternative = "lesser")
t.test(Flinch ~ Group,
data = Pain_Data, var.equal = TRUE, alternative = "less")
t.test(Flinch ~ Group,
data = Pain_Data, var.equal = TRUE)
t.test(Flinch ~ factor(Group, levels = c(Thalamus, Neutral))
data = Pain_Data, var.equal = TRUE)
t.test(Flinch ~ factor(Group, levels = c(1, 0))
data = Pain_Data, var.equal = TRUE)
t.test(Flinch ~ factor(Pain_Data$Group, levels = c("Thalamus", "Neutral"))
data = Pain_Data, var.equal = TRUE)
Pain_Data
Invisibility
glimpse(Invisibility)
t.test(Flinch ~ factor(Group, levels = c("Thalamus", "Neutral")), data = Pain_Data)
t.test(Flinch ~ factor(Group, levels = c("Thalamus", "Neutral")),
var.equal = TRUE, data = Pain_Data)
mu <- 0
sigma <- 1
infl <- c(mu - sigma, mu + sigma)   # inflection points at ±1 SD
ggplot(data.frame(x = c(mu - 4 * sigma, mu + 4 * sigma)), aes(x)) +
stat_function(fun = dnorm, args = list(mean = mu, sd = sigma), linewidth = 1) +
annotate("segment", x = mu, xend = mu, y = 0, yend = dnorm(mu, mu, sigma),
linetype = "dashed", color = "firebrick") +
annotate("text", x = mu, y = dnorm(mu, mu, sigma) + 0.02,
label = "Mean = Median = Mode", color = "firebrick") +
geom_segment(data = data.frame(x = infl),
aes(x = x, xend = x, y = 0, yend = dnorm(x, mu, sigma)),
linetype = "dotted", color = "steelblue") +
geom_point(data = data.frame(x = infl), aes(x = x, y = dnorm(x, mu, sigma)),
size = 3, color = "steelblue") +
annotate("text", x = infl, y = dnorm(infl, mu, sigma),
label = "Inflection point", hjust = c(1.1, -0.1), color = "steelblue") +
scale_x_continuous(breaks = mu + (-3:3) * sigma,
labels = c("-3 SD", "-2 SD", "-1 SD", "Mean", "+1 SD", "+2 SD", "+3 SD")) +
scale_y_continuous(expand = expansion(mult = c(0, 0.1))) +
labs(title = "The Normal Curve", x = NULL, y = "Density") +
theme_minimal()
#Libraries
library(tidyverse)
library(haven)
Invisibility <- read_sav("https://github.com/jvanster/Psy_300_Datasets/raw/refs/heads/main/SPSS_Datasets/Invisibility.sav")
#Look at the data
Invisibility
#Individual variables
Invisibility$Cloak
Invisibility$Mischief
#Find descriptive statistics
Invis_Desc <- Invisibility |>
group_by(Cloak) |>
summarise(
n = n(),
mean = mean(Mischief),
sd = sd(Mischief),
se = sd / sqrt(n),
ci = qt(0.975, df = n - 1) * sd / sqrt(n))
Invis_Desc
Invisibility <- read_sav("https://github.com/jvanster/Psy_300_Datasets/raw/refs/heads/main/SPSS_Datasets/Invisibility.sav")
#Look the dataset
Invisibility
#Look at each variable individually
Invisibility$Cloak
Invisibility$Mischief
#Calculate our descriptive statistics
Invis_Desc <- Invisibility |>
group_by(Cloak) |>
summarise(
n = n(),
mean = mean(Mischief),
sd = sd(Mischief),
se = sd /sqrt(n),
ci = qt(0.975, df = n - 1) * sd / sqrt(n)
)
Invis_Desc
#Basic bar graph
ggplot(Invis_Desc,
aes(x = Cloak,
y = mean)) +
geom_bar(stat = "identity")
#t-test
t.test(Mischief ~ factor(Cloak, levels = c(1,0)),
data = Invisibility,
var.equal = TRUE)
