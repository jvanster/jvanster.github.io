set.seed(42)
# t-distribution with df = 3 has excess kurtosis (heavy tails, sharp peak)
df_high_kurt <- tibble(x = rt(2000, df = 3))
ggplot(df_high_kurt, aes(x = x)) +
geom_histogram(aes(y = after_stat(density)), bins = 60,
fill = "steelblue", color = "white", alpha = 0.85) +
stat_function(fun = dnorm, args = list(mean = mean(df_high_kurt$x),
sd = sd(df_high_kurt$x)),
color = "firebrick", linewidth = 1, linetype = "dashed") +
labs(title = "High-Kurtosis Distribution (t-distribution, df = 3)",
subtitle = "Dashed line shows a normal curve for comparison",
x = "Value", y = "Density") +
theme_minimal(base_size = 13)
library(tidyverse)
set.seed(42)
# Positive (right) skew — long tail extends right
df_pos_skew <- tibble(x = rgamma(2000, shape = 2, rate = 1))
# Negative (left) skew — mirror the gamma by negating it
df_neg_skew <- tibble(x = -rgamma(2000, shape = 2, rate = 1))
p_pos <- ggplot(df_pos_skew, aes(x = x)) +
geom_histogram(aes(y = after_stat(density)), bins = 50,
fill = "darkorange", color = "white", alpha = 0.85) +
geom_vline(aes(xintercept = mean(x)), color = "black", linetype = "dashed") +
geom_vline(aes(xintercept = median(x)), color = "firebrick", linetype = "dotted") +
labs(title = "Positive (Right) Skew",
subtitle = "Mean (dashed) sits to the right of the median (dotted)",
x = "Value", y = "Density") +
theme_minimal(base_size = 13)
p_neg <- ggplot(df_neg_skew, aes(x = x)) +
geom_histogram(aes(y = after_stat(density)), bins = 50,
fill = "steelblue", color = "white", alpha = 0.85) +
geom_vline(aes(xintercept = mean(x)), color = "black", linetype = "dashed") +
geom_vline(aes(xintercept = median(x)), color = "firebrick", linetype = "dotted") +
labs(title = "Negative (Left) Skew",
subtitle = "Mean (dashed) sits to the left of the median (dotted)",
x = "Value", y = "Density") +
theme_minimal(base_size = 13)
p_pos
p_neg
